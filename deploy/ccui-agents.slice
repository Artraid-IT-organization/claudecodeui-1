# Общая комната агентов Claude UI (пользовательский менеджер systemd).
# Ставится в ~/.config/systemd/user/ccui-agents.slice, затем
#   systemctl --user daemon-reload
# Каждый чат — своя комната-scope внутри (server/.../agent-rooms.js).
#
# Зачем: сервер сайта и работа чатов больше не делят один потолок памяти.
# Числа под сервер 8 ГБ / 2 ядра (22.09.26): агентам вместе до 4 ГБ мягко
# (дальше их, и только их, тормозит ядро), 5 ГБ — жёсткий край, подкачки
# не больше 1 ГБ (22.09 подкачка 4/4 ГБ стояла забитой). Вес процессора
# ниже обычного: при споре за ядра первым идёт сервер сайта (CPUWeight=250).
[Unit]
Description=Claude UI — комнаты агентов (чаты веб-интерфейса)

[Slice]
MemoryHigh=4G
MemoryMax=5G
MemorySwapMax=1G
CPUWeight=40
TasksMax=4000
